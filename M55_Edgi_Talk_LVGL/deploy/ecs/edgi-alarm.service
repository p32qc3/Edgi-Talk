[Unit]
Description=Edgi alarm HTTP server (board -> DingTalk)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt
EnvironmentFile=-/opt/edgi_alarm.env
ExecStart=/usr/bin/python3 /opt/edgi_alarm_server.py
Restart=always
RestartSec=3
# Hardening (optional; remove if start fails on your image)
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
